def howsum(target, nums, arr=[]):
    if target == 0:
        return arr
    for i in range(len(nums)):
        if nums[i] <= target:
            rem = target - nums[i]
            arr.append(nums[i])
            if howsum(rem, nums, arr) == arr:
                return arr
            arr.pop()
    
    return None


print(howsum(7, [80,9,2, 5]))
